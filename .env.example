# Токен бота от @BotFather
BOT_TOKEN=

# Ключ Claude API (console.anthropic.com)
ANTHROPIC_API_KEY=

# --- Необязательные настройки (можно не менять) ---

# Модель и глубина анализа
ANTHROPIC_MODEL=claude-opus-5-5
EFFORT=medium
MAX_TOKENS=8000

# Лимиты: обращений к ИИ на пользователя в час и одновременных запросов к API
RATE_LIMIT_PER_HOUR=5
MAX_CONCURRENT_REQUESTS=5

# Окно сбора сообщений (текст + фото подряд), секунды; и максимум картинок за раз
COLLECT_DELAY=2.5
MAX_IMAGES=4

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
